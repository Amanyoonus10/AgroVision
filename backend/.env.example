# Backend Configuration
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Configuration
MODEL_ID=Kathir56/plant-disease-tamilnadu
